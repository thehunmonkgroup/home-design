  "description": "Insulated interior partition with a framed rough opening, electrical rough-in box, owned recess and an open containment interface. Stock dimensions are illustrative.",
  "parameters": {
    "origin": {
      "valueType": "point2",
      "description": "Wall start in model XY millimetres",
      "default": [
        -8000,
        1000
      ],
      "targets": [
        "/anchors/anchor.origin/position"
      ]
    },
    "width": {
      "valueType": "length",
      "description": "Wall run in millimetres",
      "default": 4000,
      "minimum": 4000,
      "maximum": 12000,
      "targets": [
        "/elements/wall.partition/path/end/offset/0"
      ]
    },
    "height": {
      "valueType": "length",
      "description": "Wall height above the storey datum",
      "default": 2400,
      "minimum": 2400,
      "maximum": 3600,
      "targets": [
        "/elements/wall.partition/top/height"
      ]
    },
    "openingWidth": {
      "valueType": "length",
      "description": "Rough opening width; explicit header stock remains unchanged",
      "default": 900,
      "minimum": 600,
      "maximum": 1200,
      "targets": [
        "/elements/opening.entry/geometry/width"
      ]
    },
    "boxHeight": {
      "valueType": "length",
      "description": "Electrical rough-in box center height",
      "default": 1200,
      "minimum": 300,
      "maximum": 2000,
      "targets": [
        "/elements/device.box/placement/origin/host/height",
        "/elements/cut.box/placement/origin/host/height"
      ]
    }
  },
  "connectionPoints": {
    "entry": {
      "element": "device.box",
      "port": "entry",
      "description": "Open containment connection; coordinate an external conduit and connection before marking connected"
    },
    "partition": {
      "element": "wall.partition",
      "description": "Architectural partition host for additional accessories and connections"
    }
  },
  "overridePaths": [
    "/elements/assembly.root/name",
    "/elements/wall.partition/name",
    "/elements/framing.partition/memberOverrides",
    "/types/type.partition/layers"
  ]
}
