{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Named model views",
  "type": "object",
  "additionalProperties": false,
  "required": ["views"],
  "properties": {
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "file"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "file": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*\\.json$"}
        }
      }
    }
  }
}
