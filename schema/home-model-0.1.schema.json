          "$ref": "#/$defs/UnitVec2"
        },
        "overhang": {
          "$ref": "#/$defs/Length"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "form": {
                "enum": [
                  "shed",
                  "gable",
                  "hip"
                ]
              }
            },
            "required": [
              "form"
            ]
          },
          "then": {
            "properties": {
              "pitch": true
            },
            "required": [
              "pitch"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "form": {
                "const": "shed"
              }
            },
            "required": [
              "form"
            ]
          },
          "then": {
            "properties": {
              "slopeDirection": true
            },
            "required": [
              "slopeDirection"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "form": {
                "const": "gable"
              }
            },
            "required": [
              "form"
            ]
          },
          "then": {
            "properties": {
              "ridgeDirection": true
            },
            "required": [
              "ridgeDirection"
            ]
          }
        }
      ]
